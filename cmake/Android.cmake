# Android game, GLES renderer, SDL platform and host validation targets.
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
if(ANDROID)
  add_compile_options(-fno-autolink)
endif()
include(FetchContent)
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
FetchContent_Declare(SDL3 URL https://github.com/libsdl-org/SDL/archive/829a65d769d935c4852f8159e964312c0957260a.tar.gz DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
if(ANDROID OR APPLE)
  FetchContent_MakeAvailable(SDL3)
else()
  find_package(SDL3 CONFIG REQUIRED)
endif()
file(GLOB_RECURSE CORE CONFIGURE_DEPENDS ${PROJECT_SOURCE_DIR}/src/Core/*.cpp)
list(FILTER CORE EXCLUDE REGEX "/(CpuInfo|Cpu|Config|Text|Log|GameSpyVoice)\\.cpp$")
add_library(juice_core STATIC ${CORE}
  src/Mac/Base.cpp src/Mac/Compat/Windows.cpp src/Mac/VoiceUnavailable.cpp)
target_include_directories(juice_core PUBLIC src src/Android/Compat src/Mac/Compat)
target_compile_options(juice_core PUBLIC -include ${PROJECT_SOURCE_DIR}/src/Mac/Compat/Crt.h)
target_compile_definitions(juice_core PUBLIC _DEBUG OJ_ANDROID)
if(ANDROID)
  # A debuggable APK still needs optimized physics and rendering on the handheld.
  target_compile_options(juice_core PUBLIC -O2 -g1)
endif()
target_link_libraries(juice_core PUBLIC SDL3::SDL3)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5 CACHE STRING "")
set(CMAKE_DISABLE_FIND_PACKAGE_SDL2 ON CACHE BOOL "" FORCE)
set(PROFILE_GLSLES3 ON CACHE BOOL "" FORCE)
FetchContent_Declare(mojoshader URL https://github.com/icculus/mojoshader/archive/ad5dff84830c2863c841f4b1f4e3df78c705b383.tar.gz DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(mojoshader)
target_compile_definitions(mojoshader PRIVATE USE_SDL3)
target_link_libraries(mojoshader PUBLIC SDL3::SDL3)
file(GLOB_RECURSE RENDER CONFIGURE_DEPENDS ${PROJECT_SOURCE_DIR}/src/Render/*.cpp)
list(FILTER RENDER EXCLUDE REGEX "D3D9/|RenderDevice\\.cpp$|HlslCompiler\\.cpp$")
add_library(juice_render STATIC ${RENDER} src/Android/Render/GlesDevice.cpp src/Android/Render/GlShader.cpp)
target_include_directories(juice_render PUBLIC ${mojoshader_SOURCE_DIR})
target_link_libraries(juice_render PUBLIC juice_core mojoshader)
if(ANDROID)
  target_link_libraries(juice_render PUBLIC GLESv3)
else()
  if(APPLE)
    target_link_libraries(juice_render PUBLIC "-framework OpenGL")
  else()
    find_package(OpenGL REQUIRED)
    target_link_libraries(juice_render PUBLIC OpenGL::GL)
  endif()
endif()
if(ANDROID)
  target_link_libraries(juice_core PUBLIC android log)
  include(${PROJECT_SOURCE_DIR}/cmake/AndroidFFmpeg.cmake)
  set(audio_libraries android_ffmpeg)
else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET libavformat libavcodec libavutil libswresample)
  set(audio_libraries PkgConfig::FFMPEG)
endif()
add_library(juice_audio STATIC src/Audio/Bank.cpp src/Audio/Player.cpp src/Audio/Voices.cpp src/Mac/Audio.cpp src/Mac/Streams.cpp)
target_link_libraries(juice_audio PUBLIC juice_core ${audio_libraries})
FetchContent_Declare(lua URL https://www.lua.org/ftp/lua-5.4.8.tar.gz URL_HASH SHA256=4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(lua)
file(GLOB LUA_SOURCE ${lua_SOURCE_DIR}/src/*.c)
list(FILTER LUA_SOURCE EXCLUDE REGEX "/lua(c)?\\.c$")
add_library(juice_lua STATIC ${LUA_SOURCE})
target_include_directories(juice_lua PUBLIC ${lua_SOURCE_DIR}/src)
target_compile_definitions(juice_lua PRIVATE LUA_USE_POSIX)
file(GLOB_RECURSE GAME CONFIGURE_DEPENDS ${PROJECT_SOURCE_DIR}/src/Game/*.cpp)
list(FILTER GAME EXCLUDE REGEX "App/(Main|CrashLog)\\.cpp$|Platform/(Platform|InputDevices|Settings|SystemKeys|Win7Imports|Windows7)\\.cpp$|Media/Binkw32\\.cpp$")
add_library(juice_game STATIC ${GAME} src/Android/Platform.cpp src/Android/SaveEditor.cpp src/Android/TouchControls.cpp src/Mac/Controls.cpp src/Mac/ControlsOverlay.cpp src/Mods/Packages.cpp src/Mods/Runtime.cpp src/Mods/Creative.cpp src/Mods/CreativeMenu.cpp src/Android/ImageImport.cpp)
target_link_libraries(juice_game PUBLIC juice_render juice_audio juice_lua)
if(ANDROID)
  add_library(main SHARED src/Android/Main.cpp src/Android/Diagnostics.cpp src/Android/Bridge.cpp)
  target_link_libraries(main PRIVATE juice_game)
  target_link_options(main PRIVATE -Wl,-z,max-page-size=16384)
else()
  pkg_check_modules(PIXBUF REQUIRED IMPORTED_TARGET gdk-pixbuf-2.0)
  target_link_libraries(juice_game PUBLIC PkgConfig::PIXBUF)
  add_executable(juiced_android_host src/Android/Main.cpp src/Android/Diagnostics.cpp)
  target_link_libraries(juiced_android_host PRIVATE juice_game)
  add_executable(gles_shader_check tools/GlesShaderCheck.cpp)
  target_link_libraries(gles_shader_check PRIVATE juice_render)
  add_executable(android_readback_check tests/Android/ReadbackTest.cpp)
  target_link_libraries(android_readback_check PRIVATE juice_game)
  add_executable(android_data_check src/Android/DataCheck.cpp)
  target_link_libraries(android_data_check PRIVATE juice_core juice_game)
  add_executable(android_touch_check tests/Android/TouchControlsTest.cpp src/Android/TouchControls.cpp)
  target_include_directories(android_touch_check PRIVATE src)
  add_executable(android_controller_check tests/Android/ControllerTest.cpp)
  target_link_libraries(android_controller_check PRIVATE juice_game)
  add_executable(race_cleanup_check tests/Android/RaceCleanupTest.cpp)
  target_link_libraries(race_cleanup_check PRIVATE juice_game)
  add_test(NAME race_cleanup COMMAND race_cleanup_check)
  enable_testing()
  add_test(NAME android_touch COMMAND android_touch_check)
  add_executable(android_touch_bindings_check tests/Android/TouchBindingsTest.cpp src/Core/Data/Controls.cpp)
  target_include_directories(android_touch_bindings_check PRIVATE src)
  target_compile_definitions(android_touch_bindings_check PRIVATE OJ_ANDROID)
  add_test(NAME android_touch_bindings COMMAND android_touch_bindings_check)
  add_executable(android_codepages_check tests/Android/CodePagesTest.cpp)
  target_include_directories(android_codepages_check PRIVATE src)
  add_test(NAME android_codepages COMMAND android_codepages_check)
endif()

if(NOT ANDROID)
  add_executable(android_loading_queue_check tests/Android/LoadingQueueTest.cpp)
  target_link_libraries(android_loading_queue_check PRIVATE juice_game)
endif()
if(NOT ANDROID)
  add_executable(android_movie_check tests/Android/MovieLoadTest.cpp)
  target_link_libraries(android_movie_check PRIVATE juice_game)
endif()
if(NOT ANDROID)
  add_executable(android_save_editor_check tests/Android/SaveEditorTest.cpp)
  target_link_libraries(android_save_editor_check PRIVATE juice_game)
  add_executable(android_mod_garage_check tests/Android/ModGarageTest.cpp)
  target_include_directories(android_mod_garage_check PRIVATE tests)
  target_link_libraries(android_mod_garage_check PRIVATE juice_game)
endif()

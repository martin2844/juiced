// The executable's version resource (Version.h): the retail build of the game it follows and OpenJuice's release.

#include <winver.h>

#include "App/Version.h"

#if defined(OJ_RC_X64)
#if defined(OJ_RC_DEBUG)
#define OJ_FILE_NAME "OpenJuice64_d.exe"
#else
#define OJ_FILE_NAME "OpenJuice64.exe"
#endif
#else
#if defined(OJ_RC_DEBUG)
#define OJ_FILE_NAME "OpenJuice_d.exe"
#else
#define OJ_FILE_NAME "OpenJuice.exe"
#endif
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OJ_GAME_VERSION_MAJOR, OJ_GAME_VERSION_MINOR, 0, OJ_RELEASE
 PRODUCTVERSION OJ_GAME_VERSION_MAJOR, OJ_GAME_VERSION_MINOR, 0, OJ_RELEASE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(OJ_RC_DEBUG)
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "OpenJuice"
      VALUE "ProductVersion", OJ_VERSION_TEXT " (Juiced " OJ_GAME_VERSION_TEXT ", " OJ_RELEASE_NAME ")"
      VALUE "FileDescription", "OpenJuice for Juiced " OJ_GAME_VERSION_TEXT " (" OJ_BUILD_TEXT ")"
      VALUE "FileVersion", OJ_VERSION_TEXT
      VALUE "InternalName", "OpenJuice"
      VALUE "OriginalFilename", OJ_FILE_NAME
      VALUE "LegalCopyright", "Copyright 2026 Sidewinder. PolyForm Noncommercial License 1.0.0"
      VALUE "Comments", "https://gitlab.com/sidecr3w/openjuice"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

    </ProjectReference>
    <ProjectReference Include="..\Audio\OpenJuice.Audio.vcxproj">
      <Project>{7A3C2E51-6B0D-4F8E-9C1A-3D5E7F902B14}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\third_party\speex-1.0.3\OpenJuice.Speex.vcxproj">
      <Project>{5C2D8E14-7A31-4B6F-9E08-2F4A6B1C3D95}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

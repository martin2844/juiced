  <!-- The objects OpenJuice.vcxproj links in place of this library (UseLibraryDependencyInputs): the game's own,
       in the project's order, as when they were the executable's; not those of the libraries it uses (the
       targets' own GetResolvedLinkObjs adds them), which the executable links as libraries. -->
  <Target Name="GetResolvedLinkObjs" Returns="@(ObjFullPath)" DependsOnTargets="$(CommonBuildOnlyTargets);ComputeCLOutputs">
    <ItemGroup>
      <ObjFullPath Include="@(Obj->'%(FullPath)')">
        <FileType>obj</FileType>
        <ProjectType>$(ConfigurationType)</ProjectType>
      </ObjFullPath>
    </ItemGroup>
  </Target>

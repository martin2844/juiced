// OpenJuiceConfig's resources: the stock JuicedConfig.exe's window (DIALOGEX 102), its two pictures, its icon and
// its texts (the string ids 110 .. 360, eight a text: docs/spec/30-juiced-config.md), with their languages; the version
// is OpenJuice's.
//
// The region build's French, Italian, German and Spanish texts went into its string table through the Cyrillic code
// page (1251), so their accented letters are Cyrillic ones ("Paramиtres", "Qualitдtsstufe"); here they have their
// own letters back ("Paramètres", "Qualitätsstufe"), the rest of the table as the stock's.

#pragma code_page(65001)

#include <winres.h>
#include <winver.h>

#include "resource.h"
#include "../Game/App/Version.h"

#if defined(OJ_RC_X64)
#if defined(OJ_RC_DEBUG)
#define OJ_FILE_NAME "OpenJuiceConfig64_d.exe"
#else
#define OJ_FILE_NAME "OpenJuiceConfig64.exe"
#endif
#else
#if defined(OJ_RC_DEBUG)
#define OJ_FILE_NAME "OpenJuiceConfig_d.exe"
#else
#define OJ_FILE_NAME "OpenJuiceConfig.exe"
#endif
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OJ_GAME_VERSION_MAJOR, OJ_GAME_VERSION_MINOR, 0, OJ_RELEASE
 PRODUCTVERSION OJ_GAME_VERSION_MAJOR, OJ_GAME_VERSION_MINOR, 0, OJ_RELEASE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(OJ_RC_DEBUG)
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "OpenJuice"
      VALUE "ProductVersion", OJ_VERSION_TEXT " (Juiced " OJ_GAME_VERSION_TEXT ", " OJ_RELEASE_NAME ")"
      VALUE "FileDescription", "OpenJuiceConfig, the settings of Juiced " OJ_GAME_VERSION_TEXT " (" OJ_BUILD_TEXT ")"
      VALUE "FileVersion", OJ_VERSION_TEXT
      VALUE "InternalName", "OpenJuiceConfig"
      VALUE "OriginalFilename", OJ_FILE_NAME
      VALUE "LegalCopyright", "Copyright 2026 Sidewinder. PolyForm Noncommercial License 1.0.0"
      VALUE "Comments", "https://gitlab.com/sidecr3w/openjuice"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_UK

IDB_PUBLISHER BITMAP "res\\publisher.bmp"
IDB_LOGO BITMAP "res\\juicegames.bmp"
IDI_ICON1 ICON "res\\juiced.ico"

IDD_CONFIG DIALOGEX 0, 0, 454, 207
STYLE 0x80c808cc
EXSTYLE 0x00040000
CAPTION "Juiced Config"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL "", IDC_ADAPTER, "ComboBox", 0x50230103, 184, 41, 119, 132, 0x0
    CONTROL "Display Adapter", IDC_ADAPTER_LABEL, "Static", 0x50000000, 184, 28, 91, 8, 0x0
    CONTROL "", IDC_MODE, "ComboBox", 0x50230003, 184, 79, 120, 132, 0x0
    CONTROL "Display Mode", IDC_MODE_LABEL, "Static", 0x50000000, 184, 65, 82, 8, 0x0
    CONTROL "Windowed", IDC_WINDOWED, "Button", 0x50030003, 184, 136, 119, 8, 0x0
    CONTROL "Display", IDC_DISPLAY_GROUP, "Button", 0x50020007, 180, 15, 127, 151, 0x20
    CONTROL "Antialiasing", IDC_ANTIALIASING_LABEL, "Static", 0x50020000, 184, 98, 88, 8, 0x0
    CONTROL IDB_PUBLISHER, IDC_PUBLISHER, "Static", 0x5000100e, 46, 156, 87, 41, 0x20
    CONTROL IDB_LOGO, IDC_LOGO, "Static", 0x5000100e, 5, 19, 172, 80, 0x20
    CONTROL "OK", IDC_OK, "Button", 0x50010000, 9, 102, 79, 23, 0x0
    CONTROL "", IDC_ANTIALIASING, "ComboBox", 0x50230103, 184, 111, 119, 132, 0x0
    CONTROL "", IDC_SHADERS, "ComboBox", 0x50210003, 315, 41, 106, 132, 0x0
    CONTROL "Shaders", IDC_SHADERS_LABEL, "Static", 0x50000000, 313, 29, 100, 8, 0x0
    CONTROL "Cancel", IDC_CANCEL, "Button", 0x50010000, 9, 129, 169, 23, 0x0
    CONTROL "Reset To Defaults", IDC_RESET, "Button", 0x50010300, 94, 102, 84, 23, 0x0
    CONTROL "", IDC_TABS, "SysTabControl32", 0x50008000, 5, 1, 439, 200, 0x10
    CONTROL "Hardware Mixing", IDC_HARDWARE_MIXING, "Button", 0x50010003, 318, 111, 100, 8, 0x0
    CONTROL "Audio", IDC_AUDIO_GROUP, "Button", 0x50000007, 310, 68, 122, 97, 0x0
    CONTROL "All Audio", IDC_ALL_AUDIO, "Button", 0x50010003, 318, 137, 96, 8, 0x0
    CONTROL "Video", IDC_VIDEO_GROUP, "Button", 0x50000007, 310, 15, 122, 51, 0x0
    CONTROL "Muisc", IDC_MUSIC, "Button", 0x50010003, 318, 99, 103, 8, 0x0
    CONTROL "Speech", IDC_SPEECH, "Button", 0x50010003, 318, 86, 104, 8, 0x0
    CONTROL "Widescreen", IDC_WIDESCREEN, "Button", 0x50030003, 184, 153, 122, 8, 0x0
    CONTROL "Input", IDC_INPUT_GROUP, "Button", 0x50000007, 310, 166, 122, 31, 0x0
    CONTROL "Multi-turn wheel", IDC_MULTI_TURN, "Button", 0x50010003, 318, 178, 104, 10, 0x0
    CONTROL "EAX", IDC_EAX, "Button", 0x50010003, 318, 124, 96, 8, 0x0
    CONTROL "MultiThreading", IDC_THREADING, "Button", 0x50010003, 184, 178, 104, 10, 0x0
    CONTROL "", IDC_THREADING_GROUP, "Button", 0x50020007, 180, 166, 127, 31, 0x20
END



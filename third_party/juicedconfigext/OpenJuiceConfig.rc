// OpenJuiceConfig's resources (the fixed build's, JuicedConfigExt's settings program): the game's logo the window
// draws over its tabs (JuicedConfigExt's IDR_LOGO), the game's icon, and OpenJuice's version.

#pragma code_page(65001)

#include <winres.h>
#include <winver.h>

#include "resource.h"
#include "Game/App/Version.h"

#if defined(OJ_RC_DEBUG)
#define OJ_FILE_NAME "OpenJuiceConfig_d.exe"
#else
#define OJ_FILE_NAME "OpenJuiceConfig.exe"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OJ_GAME_VERSION_MAJOR, OJ_GAME_VERSION_MINOR, 0, OJ_RELEASE
 PRODUCTVERSION OJ_GAME_VERSION_MAJOR, OJ_GAME_VERSION_MINOR, 0, OJ_RELEASE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(OJ_RC_DEBUG)
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "OpenJuice"
      VALUE "ProductVersion", OJ_VERSION_TEXT " (" OJ_BASED_ON_TEXT ", " OJ_RELEASE_NAME ")"
      VALUE "FileDescription", "OpenJuiceConfig, the settings of " OJ_PRODUCT_TEXT " for Juiced (" OJ_BUILD_TEXT ")"
      VALUE "FileVersion", OJ_VERSION_TEXT
      VALUE "InternalName", "OpenJuiceConfig"
      VALUE "OriginalFilename", OJ_FILE_NAME
      VALUE "LegalCopyright", "Copyright 2026 Sidewinder. PolyForm Noncommercial License 1.0.0"
      VALUE "Comments", "https://gitlab.com/sidecr3w/openjuice"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDI_APP ICON "res\\juiced.ico"
IDR_LOGO RCDATA "..\\..\\external\\JuicedConfigExt\\src\\Config\\Resources\\juiced_logo.png"

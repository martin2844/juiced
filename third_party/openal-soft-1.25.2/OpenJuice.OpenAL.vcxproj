  <!-- OpenAL Soft 1.25.2 as its CMake build makes it (README.OpenJuice.md; the sources of its OpenAL, alsoft.common
       and alsoft.fmt targets): a static library, C++20, its warnings
       (level 4 less 4127, 4324, 4373) not errors; the objects by their folders (al\ and alc\ share names). -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <DisableSpecificWarnings>4127;4324;4373;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <PreprocessorDefinitions>AL_LIBTYPE_STATIC;AL_BUILD_LIBRARY;AL_ALEXT_PROTOTYPES;ALC_API=;AL_API=;_WIN32;NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR;_MSVC_STL_HARDENING=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)include;$(MSBuildThisFileDirectory)gsl\include;$(MSBuildThisFileDirectory)openjuice-config;$(MSBuildThisFileDirectory)common;$(MSBuildThisFileDirectory)fmt-11.2.0\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>avrt.lib;winmm.lib;ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <ClCompile>
      <EnableEnhancedInstructionSet>StreamingSIMDExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
  </ItemDefinitionGroup>

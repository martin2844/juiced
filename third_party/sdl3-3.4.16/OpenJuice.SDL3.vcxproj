  <!-- SDL 3.4.16 as its VisualC project builds it (README.OpenJuice.md), a static library of the game controller support
       alone: the joysticks, the gamepads, the haptics, the sensors, the events and what they stand on; no video, audio,
       render, GPU, camera, dialogs, tray, storage or processes (openjuice-config/SDL_build_config.h). C, its warnings
       (level 3) not errors; the objects by their folders (some sources share names). -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <PreprocessorDefinitions>SDL_STATIC_LIB;SDL_OPENJUICE_STATIC;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)openjuice-config;$(MSBuildThisFileDirectory)include;$(MSBuildThisFileDirectory)include\build_config;$(MSBuildThisFileDirectory)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>setupapi.lib;winmm.lib;imm32.lib;version.lib;cfgmgr32.lib;hid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
